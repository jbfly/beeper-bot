[Unit]
Description=beeper-bot operator console
After=network.target beeper-bot.service
PartOf=beeper-bot.service

[Service]
Type=simple
WorkingDirectory=/home/jbfly/git/beeper-bot
Environment=PYTHONPATH=/home/jbfly/git/beeper-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 -m beeper_bot --config /home/jbfly/.config/beeper-bot/config.toml console --host 127.0.0.1 --port 8777 --sample-seconds 2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
