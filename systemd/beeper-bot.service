[Unit]
Description=beeper-bot control chat service (venus, matrix transport)
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Secrets (ANTHROPIC_API_KEY for the music chat); '-' = optional if absent.
EnvironmentFile=-%h/.config/beeper-bot/env
WorkingDirectory=%h/git/beeper-bot
ExecStart=%h/git/beeper-bot/.venv312/bin/beeper-bot --config %h/.config/beeper-bot/config.toml serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
