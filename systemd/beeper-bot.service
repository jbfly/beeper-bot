[Unit]
Description=beeper-bot control chat service
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/git/beeper-bot/src
WorkingDirectory=%h/git/beeper-bot
ExecStart=/usr/bin/python3 -m beeper_bot --config %h/.config/beeper-bot/config.toml serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
