[Unit]
Description=beeper-bot control chat service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/jbfly/git/beeper-bot
Environment=PYTHONPATH=/home/jbfly/git/beeper-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env python3 -m beeper_bot --config /home/jbfly/.config/beeper-bot/config.toml serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
